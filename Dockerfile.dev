# Development image for all Makefile-driven Go and shell checks.
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125

RUN apk add --no-cache \
		bash=5.3.9-r1 \
		build-base=0.5-r4 \
		ca-certificates=20260611-r0 \
		curl=8.22.0-r0 \
		docker-cli=29.5.3-r1 \
		docker-cli-compose=5.1.4-r1 \
		git=2.54.0-r0 \
		jq=1.8.2-r0 \
		make=4.4.1-r4 \
		ripgrep=15.1.0-r0 \
		shellcheck=0.11.0-r1 \
		shfmt=3.13.1-r2 \
		python3=3.14.7-r1 \
		py3-pip=26.1.2-r0

# semgrep for the security scan (make sec). Installed via pip; modern semgrep
# ships musl wheels that work on alpine. Pinned for reproducibility.
RUN pip install --break-system-packages --no-cache-dir semgrep==1.173.0

WORKDIR /work

CMD ["bash"]
