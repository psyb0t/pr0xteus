# Development image for all Makefile-driven Go and shell checks.
FROM golang:1.27rc2-alpine@sha256:dcbb18cc5fa1082364dc6aa95224b6b55429d09cbb9631a053d8064c1c367300

RUN apk add --no-cache \
		bash=5.3.9-r1 \
		build-base=0.5-r4 \
		ca-certificates=20260611-r0 \
		docker-cli=29.5.3-r0 \
		docker-cli-compose=5.1.4-r0 \
		git=2.54.0-r0 \
		jq=1.8.1-r0 \
		make=4.4.1-r4 \
		ripgrep=15.1.0-r0 \
		shellcheck=0.11.0-r1 \
		shfmt=3.13.1-r1

WORKDIR /work

COPY go.mod go.sum ./
RUN go mod download

CMD ["bash"]
