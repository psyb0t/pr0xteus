# Development image for all Makefile-driven Go and shell checks.
FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab

RUN apk add --no-cache \
		bash=5.3.9-r1 \
		build-base=0.5-r4 \
		ca-certificates=20261020-r0 \
		curl=8.23.0-r0 \
		docker-cli=29.9.3-r1 \
		docker-cli-compose=5.7.2-r0 \
		git=2.54.1-r0 \
		jq=1.8.2-r0 \
		make=4.4.1-r4 \
		ripgrep=15.1.0-r0 \
		shellcheck=0.11.0-r1 \
		shfmt=3.13.1-r3 \
		python3=3.14.10-r2 \
		py3-pip=26.1.2-r1

# semgrep for the security scan (make sec). Installed via pip; modern semgrep
# ships musl wheels that work on alpine. Pinned for reproducibility.
RUN pip install --break-system-packages --no-cache-dir semgrep==1.173.0

WORKDIR /work

CMD ["bash"]
