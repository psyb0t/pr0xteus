# Development image for all Makefile-driven Go and shell checks.
FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d

RUN apk add --no-cache \
		bash=5.3.9-r1 \
		build-base=0.5-r4 \
		ca-certificates=20260909-r0 \
		curl=8.22.0-r0 \
		docker-cli=29.8.2-r1 \
		docker-cli-compose=5.1.4-r2 \
		git=2.54.0-r0 \
		jq=1.8.2-r0 \
		make=4.4.1-r4 \
		ripgrep=15.1.0-r0 \
		shellcheck=0.11.0-r1 \
		shfmt=3.13.1-r3 \
		python3=3.14.8-r0 \
		py3-pip=26.1.2-r0

# semgrep for the security scan (make sec). Installed via pip; modern semgrep
# ships musl wheels that work on alpine. Pinned for reproducibility.
RUN pip install --break-system-packages --no-cache-dir semgrep==1.173.0

WORKDIR /work

CMD ["bash"]
