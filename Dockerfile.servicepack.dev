# Development Dockerfile
# Pinned by digest, not by tag — a tag is mutable and lets an upstream
# republish different bytes under the same name. Bump deliberately.
FROM golang:1.27rc2-alpine@sha256:dcbb18cc5fa1082364dc6aa95224b6b55429d09cbb9631a053d8064c1c367300

# Install build dependencies
RUN apk add --no-cache \
    make \
    gcc \
    musl-dev \
    bash \
    curl \
    git \
    jq \
    shellcheck \
    shfmt

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Set env vars
ENV ENV=dev
ENV LOG_LEVEL=debug
ENV LOG_FORMAT=text
ENV LOG_ADD_SOURCE=true
ENV SERVICES_ENABLED=
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org

# Default command - shows available make targets
CMD ["make", "help"]
