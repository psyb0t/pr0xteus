# Copy this to .env, then replace every absolute path and image digest below.
# Never commit .env, WireGuard bundles, routing policy, or the API token.

# Optional operator override. Omit it to use the cell image baked into the
# controller release: latest -> cell-latest; vX.Y.Z -> cell-vX.Y.Z. An override
# must use a published tag plus immutable digest unless the local-only escape
# hatch below is enabled.
PR0XTEUS_CELL_IMAGE=psyb0t/pr0xteus:cell-vX.Y.Z@sha256:REPLACE_WITH_PUBLISHED_DIGEST
PR0XTEUS_ALLOW_UNPINNED_CELL_IMAGE=false

# These must be absolute HOST paths. The bundle path is deliberately mounted at
# that exact same path inside the orchestrator, so Docker can mount one selected
# file into each cell without ever receiving a path from an API caller.
PR0XTEUS_BUNDLE_DIR=/absolute/path/to/pr0xteus/secrets/wireguard
PR0XTEUS_POOLS_FILE=/absolute/path/to/pr0xteus/secrets/pools.yaml
PR0XTEUS_ROUTING_FILE=/absolute/path/to/pr0xteus/config/egress-routing.yaml
PR0XTEUS_API_TOKEN_FILE=/absolute/path/to/pr0xteus/secrets/pr0xteus_api_token

# Ports are loopback-only in compose.yaml.
PR0XTEUS_HTTP_PORT=8000
PR0XTEUS_METRICS_PORT=9091

LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=true
