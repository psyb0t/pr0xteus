# Copy this to .env, then replace the path, image, and token.
# Never commit .env, WireGuard bundles, routing policy, or the API token.

# The controller bind-mounts this absolute host directory into itself at the
# same path so Docker can mount a selected WireGuard file into a cell.
PR0XTEUS_CONFIG_DIR=/absolute/path/to/pr0xteus

# Required private controller bearer token. `pr0xteus config init` generates a
# random value here with owner-only permissions.
PR0XTEUS_API_TOKEN=REPLACE_ME

# Published controller image. Keep this aligned with the initializer image.
PR0XTEUS_CONTROLLER_IMAGE=psyb0t/pr0xteus:latest

# Optional operator override. Omit it to use the cell image baked into the
# controller release: latest -> cell-latest; vX.Y.Z -> cell-vX.Y.Z. An override
# must use a published tag plus immutable digest unless the local-only escape
# hatch below is enabled.
PR0XTEUS_CELL_IMAGE=psyb0t/pr0xteus:cell-vX.Y.Z@sha256:REPLACE_WITH_PUBLISHED_DIGEST
PR0XTEUS_ALLOW_UNPINNED_CELL_IMAGE=false

# Ports are loopback-only in docker-compose.yml.
PR0XTEUS_HTTP_PORT=8000
PR0XTEUS_METRICS_PORT=9091

# Optional tailnet-only API. Set this true and add a reusable or ephemeral
# auth key from your own tailnet; `pr0xteus start` wires the sidecar to the
# authenticated controller API. The sidecar runs kernel-mode Tailscale; the
# compose file fixes TS_USERSPACE=false + NET_ADMIN/NET_RAW + /dev/net/tun and
# TS_STATE_DIR, so it has its own tailnet identity. Only the three values below
# are operator-set.
PR0XTEUS_TAILSCALE_ENABLED=false
TS_AUTHKEY=your-tailscale-auth-key
TS_HOSTNAME=pr0xteus
# TS_EXTRA_ARGS is passed verbatim to `tailscale up` — the place for every other
# flag. For Headscale, point it at your control server (with a Headscale-issued
# pre-auth key in TS_AUTHKEY above):
#   TS_EXTRA_ARGS=--login-server=https://headscale.example.com --accept-dns=false
TS_EXTRA_ARGS=--accept-dns=false

LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=true
